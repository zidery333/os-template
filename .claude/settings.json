{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "Plain words",
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": [
      "Bash(./os:*)"
    ],
    "deny": [
      "Read(/.os/backups/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh\"",
            "timeout": 15,
            "statusMessage": "Looking at the folder…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/keep-the-record.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/mark-dirty.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/settle.sh\"",
            "timeout": 60,
            "async": true,
            "statusMessage": "Updating the list…"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/plain-words.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
